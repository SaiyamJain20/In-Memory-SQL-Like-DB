{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CDB_WERROR": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CDB_WERROR": "ON",
        "CDB_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CDB_SANITIZER": "address",
        "CDB_WERROR": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CDB_SANITIZER": "thread",
        "CDB_WERROR": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "description": "libFuzzer + ASan/UBSan (clang). The gcc-install-dir pin works around a GCC 14 dir without libstdc++ on this machine / the CI image.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "--gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/13 -fsanitize=fuzzer-no-link",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CDB_SANITIZER": "address",
        "CDB_BUILD_FUZZ": "ON",
        "CDB_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-parallel",
      "inherits": "debug",
      "description": "The whole suite with 4 threads, one-vector morsels and every parallel threshold at 1",
      "environment": {
        "CDB_THREADS": "4",
        "CDB_MORSEL_ROWS": "2048",
        "CDB_PARTITION_MIN_GROUPS": "1",
        "CDB_JOIN_PARALLEL_MIN_ROWS": "1",
        "CDB_SORT_PARALLEL_MIN_ROWS": "1",
        "CDB_CSV_PARALLEL_MIN_BYTES": "1"
      }
    },
    {
      "name": "release-parallel",
      "inherits": "release",
      "description": "As debug-parallel",
      "environment": {
        "CDB_THREADS": "4",
        "CDB_MORSEL_ROWS": "2048",
        "CDB_PARTITION_MIN_GROUPS": "1",
        "CDB_JOIN_PARALLEL_MIN_ROWS": "1",
        "CDB_SORT_PARALLEL_MIN_ROWS": "1",
        "CDB_CSV_PARALLEL_MIN_BYTES": "1"
      }
    },
    {
      "name": "asan-parallel",
      "inherits": "asan",
      "description": "As debug-parallel (keeps the UBSan options of asan)",
      "environment": {
        "CDB_THREADS": "4",
        "CDB_MORSEL_ROWS": "2048",
        "CDB_PARTITION_MIN_GROUPS": "1",
        "CDB_JOIN_PARALLEL_MIN_ROWS": "1",
        "CDB_SORT_PARALLEL_MIN_ROWS": "1",
        "CDB_CSV_PARALLEL_MIN_BYTES": "1"
      }
    },
    {
      "name": "tsan-parallel",
      "inherits": "tsan",
      "description": "As debug-parallel",
      "environment": {
        "CDB_THREADS": "4",
        "CDB_MORSEL_ROWS": "2048",
        "CDB_PARTITION_MIN_GROUPS": "1",
        "CDB_JOIN_PARALLEL_MIN_ROWS": "1",
        "CDB_SORT_PARALLEL_MIN_ROWS": "1",
        "CDB_CSV_PARALLEL_MIN_BYTES": "1"
      }
    }
  ]
}
