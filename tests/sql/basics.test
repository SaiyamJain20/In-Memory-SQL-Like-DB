erin
heidi
judy

query IT
SELECT id, CASE WHEN salary IS NULL THEN 'unknown' WHEN salary >= 5000 THEN 'high' ELSE 'low' END FROM emp ORDER BY id;
----
1	high
2	low
3	high
4	low
5	low
6	low
7	high
8	unknown
9	low
10	unknown
11	high

