0

query I
SELECT 1 + 2 * 3;
----
7

query TIT
SELECT 'a' || 'b', 7 % 4, CASE WHEN 1 < 2 THEN 'yes' ELSE 'no' END;
----
ab	3	yes

query II
SELECT id, id * id FROM emp WHERE id <= 4 ORDER BY id DESC;
----
