3	9
2	4
1	1

query T
SELECT name FROM emp WHERE name LIKE 'a%' OR name LIKE '%e' ORDER BY name;
----
alice
dave
grace

query T
SELECT name FROM emp WHERE name LIKE '_ra%' ORDER BY name;
----
