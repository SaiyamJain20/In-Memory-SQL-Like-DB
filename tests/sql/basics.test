query TR
SELECT name, salary * 2 FROM emp WHERE salary > 4500 ORDER BY name;
----
Mallory	14000.0
alice	10001.0
carol	12200.5
erin	9601.5
grace	10001.0

query T
SELECT name FROM emp WHERE salary BETWEEN 4000 AND 5000 ORDER BY name;
----
bob
erin
ivan

query T
SELECT name FROM emp WHERE salary NOT BETWEEN 4000 AND 5000 ORDER BY name;
----
Mallory
alice
carol
dave
frank
grace

query T
SELECT name FROM emp WHERE dept IN (10, 30) ORDER BY id;
----
alice
bob
erin
grace
judy

query T
SELECT name FROM emp WHERE dept NOT IN (10, 30) ORDER BY id;
----
carol
dave
heidi
ivan
Mallory

query T
SELECT name FROM emp WHERE dept NOT IN (10, 30, NULL) ORDER BY id;
----

query T
SELECT name FROM emp WHERE dept IS NULL OR salary IS NULL ORDER BY id;
----
frank
heidi
judy

query T
SELECT name FROM emp WHERE dept IS NOT NULL AND salary IS NOT NULL AND boss IS NULL ORDER BY id;
----
alice
Mallory

