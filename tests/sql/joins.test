query II
SELECT count(*), count(DISTINCT e.id) FROM emp e, dept d;
----
55	11

query IT
SELECT count(*), max(d.city) FROM emp e CROSS JOIN dept d WHERE e.id <= 2;
----
10	rome

query TT
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept < d.id AND d.id <= 30 AND e.id <= 3 ORDER BY e.id, d.id;
----
alice	ops
alice	sales
bob	ops
bob	sales
carol	sales

query TT
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept = d.id OR e.boss = d.id WHERE e.id <= 6 ORDER BY e.id, d.id;
----
alice	eng
bob	eng
carol	ops
dave	ops
erin	sales

query TT
SELECT d.dname, t.c FROM dept d JOIN (SELECT dept, count(*) AS c FROM emp GROUP BY dept) t ON t.dept = d.id ORDER BY d.id;
----
eng	3
ops	3
sales	2
hr	1

query TI
SELECT d.dname, coalesce(t.c, 0) FROM dept d LEFT JOIN (SELECT dept, count(*) AS c FROM emp GROUP BY dept) t ON t.dept = d.id ORDER BY d.id;
----
eng	3
ops	3
sales	2
hr	1
legal	0

query TIR
SELECT d.dname, count(e.id), sum(e.salary) FROM dept d LEFT JOIN emp e ON e.dept = d.id GROUP BY d.dname ORDER BY d.dname;
----
eng	3	14201.0
hr	1	NULL
legal	0	NULL
ops	3	14200.25
sales	2	4800.75

query TIR
SELECT d.city, count(*), avg(e.salary) FROM emp e JOIN dept d ON e.dept = d.id GROUP BY d.city ORDER BY d.city NULLS LAST;
----
berlin	5	4750.4375
paris	3	4733.416666666667
NULL	1	NULL

query TI
SELECT d.dname, count(*) FROM emp e JOIN dept d ON e.dept = d.id GROUP BY d.dname HAVING count(*) > 1 ORDER BY d.dname;
----
eng	3
ops	3
sales	2

query T
SELECT e.name FROM emp e JOIN dept d ON e.dept = d.id WHERE d.dname = 'eng' AND e.salary > 4500 ORDER BY e.id;
----
alice
grace

query TT
SELECT x.name, y.title FROM (SELECT name, id FROM emp WHERE salary > 4000) x JOIN (SELECT title, owner FROM proj WHERE budget < 100) y ON y.owner = x.id ORDER BY x.name, y.title;
----
alice	beta
carol	gamma

query II
SELECT count(*), count(p.pid) FROM emp e LEFT JOIN proj p ON p.owner = e.id;
----
12	4

query I
SELECT count(*) FROM emp e JOIN dept d ON e.dept = d.id JOIN emp b ON e.boss = b.id;
----
7

query TT
SELECT e.name, p.title FROM emp e JOIN proj p ON e.id = p.owner AND e.dept = 10 ORDER BY p.pid;
----
alice	alpha
alice	beta
grace	zeta

query I
SELECT count(*) FROM emp e JOIN proj p ON e.id = p.owner WHERE p.owner IS NULL;
----
0

statement ok
CREATE TABLE nothing (id INTEGER, x VARCHAR);

query T
SELECT e.name FROM emp e JOIN nothing n ON e.id = n.id ORDER BY e.id;
----

query TT
SELECT e.name, n.x FROM emp e LEFT JOIN nothing n ON e.id = n.id ORDER BY e.id LIMIT 3;
----
alice	NULL
bob	NULL
carol	NULL

query TT
SELECT n.x, e.name FROM nothing n LEFT JOIN emp e ON e.id = n.id;
----

query I
SELECT count(*) FROM emp e, nothing n;
----
0
