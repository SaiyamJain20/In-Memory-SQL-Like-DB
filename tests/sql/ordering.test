# ORDER BY edge cases: bytewise string order, empty strings, duplicates, mixed directions, NULL
# placement, expressions and ordinals in the sort key, ORDER BY with LIMIT and OFFSET.

statement ok
CREATE TABLE w (id INTEGER, s VARCHAR, n INTEGER, d DOUBLE);

statement ok
INSERT INTO w VALUES
 (1, 'b', 3, 1.5), (2, 'B', 3, NULL), (3, '', 1, -0.5), (4, 'a', NULL, 2.0), (5, 'ab', 2, 2.0),
 (6, 'a', 2, 0.0), (7, NULL, 2, 1.5), (8, 'Z', NULL, -3.25), (9, 'z', 1, 100.0), (10, 'b', 3, 1.5),
 (11, 'abc', 5, NULL), (12, '~', 0, 0.25);

