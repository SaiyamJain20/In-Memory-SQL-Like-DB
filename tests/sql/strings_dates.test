query TT
SELECT CAST(DATE '2000-01-31' + INTERVAL '1' MONTH AS DATE), CAST(DATE '2000-03-31' - INTERVAL '1' MONTH AS DATE);
----
2000-02-29	2000-02-29

query TT
SELECT CAST(DATE '1998-12-01' - INTERVAL '90' DAY AS DATE), CAST(DATE '1994-01-01' + INTERVAL '1' YEAR AS DATE);
----
1998-09-02	1995-01-01

query T
SELECT max(hired) FROM emp;
----
2022-01-01

query T
SELECT min(hired) FROM emp WHERE dept = 20;
----
2014-01-20

query IT
SELECT id, CAST(hired AS VARCHAR) FROM emp WHERE id < 4 ORDER BY id;
----
1	2015-03-01
2	2016-07-15
3	2014-01-20

query TTI
SELECT CAST('2020-03-04' AS DATE), CAST(12 AS VARCHAR), CAST('42' AS INTEGER);
----
2020-03-04	12	42

query IRT
SELECT CAST(7 AS DOUBLE), CAST(CAST(2.5 AS DOUBLE) AS INTEGER) + 0, CAST(CAST(3.5 AS DOUBLE) AS INTEGER) + 0;
----
7.0	2	4

query II
SELECT CAST(CAST(-2.5 AS DOUBLE) AS INTEGER), CAST(CAST(2.4 AS DOUBLE) AS BIGINT);
----
-2	2

query T
SELECT CASE WHEN CAST('abc' AS VARCHAR) = 'abc' THEN 'same' END;
----
same

