# VARCHAR and DOUBLE keys
query T
SELECT dname FROM dept WHERE dname IN (SELECT lower(dname) FROM dept WHERE id < 40) AND dname IN ('eng', 'hr', 'ops') ORDER BY dname;
----
eng
ops

query T
SELECT name FROM emp WHERE salary IN (SELECT salary FROM emp WHERE dept = 20) ORDER BY id;
