alice	eng
carol	ops
erin	sales
grace	eng

query TT rowsort
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept = d.id WHERE NOT EXISTS (SELECT 1 FROM proj p WHERE p.dept = d.id);
