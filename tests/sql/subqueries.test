# Subqueries: scalar (uncorrelated and correlated), EXISTS / NOT EXISTS, IN / NOT IN, nested ones,
# their interaction with joins, NULLs and empty inputs. Expected results come from DuckDB.

statement ok
CREATE TABLE emp (id INTEGER NOT NULL, name VARCHAR, dept INTEGER, salary DOUBLE, boss INTEGER);

statement ok
INSERT INTO emp VALUES
 (1, 'alice', 10, 5000.5, NULL),
 (2, 'bob', 10, 4200.0, 1),
 (3, 'carol', 20, 6100.25, 1),
 (4, 'dave', 20, 3900.0, 3),
 (5, 'erin', 30, 4800.75, 3),
 (6, 'frank', NULL, 3500.0, 2),
 (7, 'grace', 10, 5000.5, 1),
 (8, 'heidi', 40, NULL, NULL),
 (9, 'ivan', 20, 4200.0, 3),
 (10, 'judy', 30, NULL, 5),
 (11, 'mallory', 70, 7000.0, NULL);

statement ok
CREATE TABLE dept (id INTEGER, dname VARCHAR);

statement ok
INSERT INTO dept VALUES (10, 'eng'), (20, 'ops'), (30, 'sales'), (40, 'hr'), (50, 'legal'), (NULL, 'ghost');

statement ok
CREATE TABLE proj (pid INTEGER, owner INTEGER, dept INTEGER, budget DOUBLE);

statement ok
INSERT INTO proj VALUES (1, 1, 10, 100.5), (2, 1, 10, 50.25), (3, 3, 20, 75.0), (4, 99, 20, 10.0),
 (5, NULL, 30, 5.5), (6, 7, 10, 200.0), (7, 3, 20, 300.0), (8, 5, NULL, 1.0);

statement ok
CREATE TABLE a (x INTEGER);

statement ok
INSERT INTO a VALUES (1), (1), (2), (3), (NULL);

statement ok
CREATE TABLE b (y INTEGER);

statement ok
INSERT INTO b VALUES (1), (2), (2), (NULL);

statement ok
CREATE TABLE c (z INTEGER);

statement ok
INSERT INTO c VALUES (1), (2), (4);

statement ok
CREATE TABLE nothing (n INTEGER, s VARCHAR);

# ------------------------------------------------------------------ uncorrelated scalar subqueries

query TR rowsort
SELECT name, salary FROM emp WHERE salary > (SELECT avg(salary) FROM emp);
----
alice	5000.5
carol	6100.25
grace	5000.5
mallory	7000.0

query IR
SELECT id, salary - (SELECT min(salary) FROM emp) AS above_min FROM emp ORDER BY id;
----
1	1500.5
2	700.0
3	2600.25
4	400.0
5	1300.75
6	0.0
7	1500.5
8	NULL
9	700.0
10	NULL
11	3500.0

query I
SELECT (SELECT count(*) FROM emp);
----
11

query IIII
SELECT (SELECT count(*) FROM nothing), (SELECT count(n) FROM nothing), (SELECT sum(n) FROM nothing), (SELECT max(n) FROM nothing);
----
0	0	NULL	NULL

query T
SELECT dname FROM dept WHERE id = (SELECT max(id) FROM dept);
----
legal

query IT
SELECT id, (SELECT dname FROM dept WHERE id = 10) AS d FROM emp ORDER BY id LIMIT 3;
----
1	eng
2	eng
3	eng

# a one-row subquery that is not an aggregate: its value, or NULL when it returns no row
query IT
SELECT (SELECT id FROM dept WHERE dname = 'hr'), (SELECT dname FROM dept WHERE dname = 'nope');
----
40	NULL

query TI
SELECT name, (SELECT n FROM nothing) FROM emp WHERE id <= 2 ORDER BY id;
----
alice	NULL
bob	NULL

# comparing with a NULL scalar keeps nothing
query T
SELECT name FROM emp WHERE salary > (SELECT max(n) FROM nothing);
----

query I
SELECT count(*) FROM emp WHERE (salary > (SELECT max(n) FROM nothing)) IS NULL;
----
11

query IR
SELECT id, salary * (SELECT 2) + (SELECT avg(budget) FROM proj) AS v FROM emp WHERE id < 4 ORDER BY id;
----
1	10093.78125
2	8492.78125
3	12293.28125

query RR
SELECT (SELECT min(budget) FROM proj), (SELECT max(budget) FROM proj) - (SELECT min(budget) FROM proj);
----
1.0	299.0

# a scalar subquery inside a scalar subquery
query T
SELECT name FROM emp WHERE id = (SELECT max(id) FROM emp WHERE salary < (SELECT avg(salary) FROM emp));
----
ivan

# in HAVING, ORDER BY and with GROUP BY
query IIR
SELECT dept, count(*), sum(salary) FROM emp GROUP BY dept HAVING sum(salary) > (SELECT avg(salary) FROM emp) ORDER BY dept;
----
10	3	14201.0
20	3	14200.25
70	1	7000.0

query IR
SELECT dept, sum(salary) - (SELECT sum(budget) FROM proj) AS d FROM emp GROUP BY dept ORDER BY dept;
----
10	13458.75
20	13458.0
30	4058.5
40	NULL
70	6257.75
NULL	2757.75

query T
SELECT name FROM emp ORDER BY salary - (SELECT avg(salary) FROM emp) DESC NULLS LAST, id LIMIT 3;
----
mallory
carol
alice

# CASE / COALESCE around a subquery
query IT
SELECT id, CASE WHEN salary > (SELECT avg(salary) FROM emp) THEN 'high' ELSE 'low' END FROM emp ORDER BY id;
----
1	high
2	low
3	high
4	low
5	low
6	low
7	high
8	low
9	low
10	low
11	high

query IR
SELECT id, coalesce(salary, (SELECT avg(salary) FROM emp)) FROM emp WHERE salary IS NULL ORDER BY id;
----
8	4855.777777777777
10	4855.777777777777

# the same subquery twice, over a join
query TT rowsort
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept = d.id WHERE e.salary > (SELECT avg(salary) FROM emp) AND d.id < (SELECT max(id) FROM dept);
----
alice	eng
carol	ops
grace	eng

# a subquery over an aggregate with GROUP BY returns several rows: an error in both engines
statement error
SELECT (SELECT dept FROM emp GROUP BY dept);

statement error
SELECT name FROM emp WHERE salary = (SELECT salary FROM emp);

statement error
SELECT name FROM emp WHERE id = (SELECT id, dept FROM emp WHERE id = 1);

