# ------------------------------------------------------------------ nesting

# EXISTS in a subquery of IN
query T
SELECT name FROM emp WHERE id IN (SELECT owner FROM proj p WHERE EXISTS (SELECT 1 FROM dept d WHERE d.id = p.dept AND d.dname = 'eng')) ORDER BY id;
----
alice
grace

# a scalar subquery inside an EXISTS subquery
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.budget > (SELECT avg(budget) FROM proj)) ORDER BY id;
----
alice
carol
grace

# a correlated scalar subquery inside a correlated EXISTS (two levels of correlation)
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.budget >= (SELECT max(budget) FROM proj q WHERE q.dept = p.dept)) ORDER BY id;
----
carol
grace

# NOT EXISTS inside NOT EXISTS: owners all of whose projects are cheap
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) AND NOT EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.budget > 100) ORDER BY id;
----
erin

# subqueries over derived tables with subqueries
query T
SELECT name FROM emp WHERE dept IN (SELECT id FROM dept WHERE id IN (SELECT dept FROM proj)) ORDER BY id;
----
alice
bob
carol
dave
erin
grace
ivan
judy

query I
SELECT count(*) FROM (SELECT * FROM emp WHERE salary > (SELECT avg(salary) FROM emp)) t;
----
4

query T
SELECT t.name FROM (SELECT name, (SELECT count(*) FROM proj WHERE owner = emp.id) AS n FROM emp) t WHERE t.n > 1 ORDER BY t.name;
----
alice
carol

# a subquery in the select list of a subquery
query I
SELECT count(*) FROM emp WHERE id IN (SELECT (SELECT max(owner) FROM proj) - 1);
----
0

# aggregation over a semi-joined input
query RI
SELECT avg(salary), count(*) FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.dept = e.dept);
----
4743.142857142857	8

query IR
SELECT dept, max(salary) FROM emp WHERE dept IN (SELECT dept FROM proj) AND salary > (SELECT min(salary) FROM emp) GROUP BY dept ORDER BY dept;
----
10	5000.5
20	6100.25
30	4800.75

# DISTINCT, ORDER BY and LIMIT above subqueries
query I
SELECT DISTINCT dept FROM emp WHERE id IN (SELECT owner FROM proj) ORDER BY dept NULLS LAST;
----
10
20
30

query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) ORDER BY salary DESC NULLS LAST, id LIMIT 2;
----
carol
alice

# an INSERT ... SELECT with a subquery
statement ok
CREATE TABLE rich (id INTEGER, name VARCHAR);

statement ok
INSERT INTO rich SELECT id, name FROM emp WHERE salary > (SELECT avg(salary) FROM emp) AND EXISTS (SELECT 1 FROM proj WHERE owner = emp.id);

query IT
SELECT id, name FROM rich ORDER BY id;
----
1	alice
3	carol
7	grace

# an empty outer table
query I
SELECT count(*) FROM nothing WHERE n IN (SELECT id FROM emp);
----
0

query I
SELECT count(*) FROM nothing WHERE n NOT IN (SELECT id FROM emp);
----
0

query I
SELECT count(*) FROM nothing WHERE EXISTS (SELECT 1 FROM emp);
----
0

query I
SELECT (SELECT max(salary) FROM emp WHERE dept = n.n) FROM nothing n;
----
