# EXISTS on a derived table
query T
SELECT name FROM (SELECT * FROM emp WHERE salary IS NOT NULL) e WHERE EXISTS (SELECT 1 FROM dept d WHERE d.id = e.dept AND d.dname <> 'eng') ORDER BY id;
----
carol
dave
erin
ivan

# ------------------------------------------------------------------ IN / NOT IN

query I
SELECT x FROM a WHERE x IN (SELECT y FROM b) ORDER BY x;
----
1
1
2

# duplicates in the subquery do not duplicate outer rows
query I
SELECT count(*) FROM a WHERE x IN (SELECT y FROM b);
----
3

# NOT IN with a NULL on the right: nothing is certainly "not in"
query I
SELECT x FROM a WHERE x NOT IN (SELECT y FROM b) ORDER BY x;
----

# NOT IN without NULLs on the right: a NULL on the left is unknown and dropped
query I
SELECT x FROM a WHERE x NOT IN (SELECT z FROM c) ORDER BY x;
----
3

query I
SELECT x FROM a WHERE x IN (SELECT z FROM c) ORDER BY x;
----
1
1
2

# an empty subquery: IN is false, NOT IN is true - even for a NULL on the left
query I
SELECT count(*) FROM a WHERE x IN (SELECT n FROM nothing);
----
0

query I
SELECT count(*) FROM a WHERE x NOT IN (SELECT n FROM nothing);
----
5

# NULLs filtered out of the subquery make NOT IN usable again
query I
SELECT x FROM a WHERE x NOT IN (SELECT y FROM b WHERE y IS NOT NULL) ORDER BY x;
----
3

# a subquery that is only NULLs
query I
SELECT count(*) FROM a WHERE x NOT IN (SELECT y FROM b WHERE y IS NULL);
----
0

query I
SELECT count(*) FROM a WHERE x IN (SELECT y FROM b WHERE y IS NULL);
----
0

# correlated IN (a correlated NOT IN is not supported yet: see the binder tests)
query T
SELECT name FROM emp e WHERE e.id IN (SELECT owner FROM proj p WHERE p.dept = e.dept) ORDER BY id;
----
alice
carol
grace

