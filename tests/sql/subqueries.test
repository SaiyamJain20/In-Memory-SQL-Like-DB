heidi	hr

# the subquery refers to both sides of the join
query TT rowsort
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept = d.id WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.dept = d.id);
----
alice	eng
carol	ops
grace	eng

# on the preserved and on the null-supplying side of an outer join
query TT rowsort
SELECT e.name, d.dname FROM emp e LEFT JOIN dept d ON e.dept = d.id WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id);
----
alice	eng
carol	ops
erin	sales
grace	eng

query TT rowsort
SELECT e.name, d.dname FROM emp e LEFT JOIN dept d ON e.dept = d.id WHERE EXISTS (SELECT 1 FROM proj p WHERE p.dept = d.id);
----
alice	eng
