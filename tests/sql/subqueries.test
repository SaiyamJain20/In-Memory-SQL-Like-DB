# unqualified names resolve to the innermost query first
query IR
SELECT pid, (SELECT max(salary) FROM emp WHERE emp.dept = proj.dept) FROM proj ORDER BY pid;
----
1	5000.5
2	5000.5
3	6100.25
4	6100.25
5	4800.75
6	5000.5
7	6100.25
8	NULL

# the outer query's table is aliased, the inner one is the same table
query TT rowsort
SELECT a.name, b.name FROM emp a JOIN emp b ON a.boss = b.id WHERE a.salary < (SELECT max(salary) FROM emp c WHERE c.dept = a.dept);
----
bob	alice
dave	carol
ivan	carol

# correlated scalar subquery on the inner side of a join
query TT rowsort
SELECT e.name, d.dname FROM emp e JOIN dept d ON d.id = e.dept WHERE e.salary = (SELECT max(salary) FROM emp i WHERE i.dept = d.id);
----
alice	eng
carol	ops
erin	sales
grace	eng

# correlated scalar subquery in the select list with another subquery
query TIR
SELECT name, (SELECT count(*) FROM proj WHERE owner = emp.id), (SELECT avg(salary) FROM emp) FROM emp WHERE id < 4 ORDER BY id;
----
alice	2	4855.777777777777
bob	0	4855.777777777777
carol	2	4855.777777777777

# comparison of two correlated subqueries
query T
SELECT name FROM emp WHERE (SELECT count(*) FROM proj WHERE owner = emp.id) > (SELECT count(*) FROM emp i WHERE i.boss = emp.id) ORDER BY id;
----
grace

# ------------------------------------------------------------------ EXISTS / NOT EXISTS

query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) ORDER BY id;
----
alice
carol
erin
grace

query T
SELECT name FROM emp e WHERE NOT EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) ORDER BY id;
----
bob
dave
frank
heidi
ivan
judy
mallory

# several matching inner rows do not duplicate the outer row
query IT
SELECT id, name FROM emp e WHERE EXISTS (SELECT * FROM proj p WHERE p.dept = e.dept) ORDER BY id;
----
1	alice
2	bob
3	carol
4	dave
5	erin
7	grace
9	ivan
10	judy

# a NULL outer key: EXISTS drops the row, NOT EXISTS keeps it
query IT
SELECT id, name FROM emp e WHERE NOT EXISTS (SELECT 1 FROM proj p WHERE p.dept = e.dept) ORDER BY id;
----
6	frank
8	heidi
11	mallory

# residual (non-equality) correlation
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.budget > e.salary / 50) ORDER BY id;
----
alice
carol
grace

query T
SELECT name FROM emp e WHERE NOT EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.budget > e.salary / 50) ORDER BY id;
----
bob
dave
erin
frank
heidi
ivan
judy
mallory

# only a non-equality correlation: no hash keys at all
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.budget > e.salary / 20) ORDER BY id;
----
alice
bob
dave
erin
frank
grace
ivan

query T
SELECT name FROM emp e WHERE NOT EXISTS (SELECT 1 FROM proj p WHERE p.budget > e.salary / 20) ORDER BY id;
----
carol
heidi
judy
mallory

# two equality keys plus an inner filter
query T
SELECT name FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id AND p.dept = e.dept AND p.budget < 150) ORDER BY id;
----
alice
carol

# uncorrelated EXISTS is a constant
query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT 1 FROM proj WHERE budget > 250);
----
11

query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT 1 FROM proj WHERE budget > 1000);
----
0

query I
SELECT count(*) FROM emp WHERE NOT EXISTS (SELECT 1 FROM proj WHERE budget > 1000);
----
11

query I
SELECT count(*) FROM emp WHERE NOT EXISTS (SELECT 1 FROM proj WHERE budget > 250);
----
0

query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT 1 FROM nothing);
----
0

query I
SELECT count(*) FROM emp WHERE NOT EXISTS (SELECT 1 FROM nothing);
----
11

# an aggregate in the select list makes the subquery return a row whatever its WHERE lets through:
# EXISTS is TRUE, even over an empty table
query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT count(*) FROM nothing);
----
11

query I
SELECT count(*) FROM emp WHERE NOT EXISTS (SELECT max(n) FROM nothing);
----
0

query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT sum(budget) FROM proj WHERE budget > 1000);
----
11

# EXISTS over an empty table, correlated
query T
SELECT name FROM emp e WHERE NOT EXISTS (SELECT 1 FROM nothing n WHERE n.n = e.id) ORDER BY id LIMIT 3;
----
alice
bob
carol

query I
SELECT count(*) FROM emp e WHERE EXISTS (SELECT 1 FROM nothing n WHERE n.n = e.id);
----
0

# EXISTS combined with ordinary conjuncts
query T
SELECT name FROM emp e WHERE salary > 4000 AND EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) AND NOT EXISTS (SELECT 1 FROM emp s WHERE s.boss = e.id AND s.salary > 4500) ORDER BY id;
----
erin
grace

# EXISTS with grouping or a limit inside, uncorrelated
query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT dept FROM emp GROUP BY dept HAVING count(*) > 2);
----
11

query I
SELECT count(*) FROM emp WHERE EXISTS (SELECT 1 FROM proj LIMIT 1);
----
11

# above an aggregation and through a join
query II
SELECT dept, count(*) FROM emp e WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id) GROUP BY dept ORDER BY dept;
----
10	2
20	1
30	1

query TT rowsort
SELECT e.name, d.dname FROM emp e JOIN dept d ON e.dept = d.id WHERE EXISTS (SELECT 1 FROM proj p WHERE p.owner = e.id);
