# DDL and INSERT: column lists, NOT NULL, INSERT ... SELECT, atomic failures, IF [NOT] EXISTS.

statement ok
CREATE TABLE t (a INTEGER NOT NULL, b VARCHAR, c DOUBLE);

statement error
CREATE TABLE t (a INTEGER);

statement ok
CREATE TABLE IF NOT EXISTS t (a INTEGER);

statement ok
INSERT INTO t VALUES (1, 'one', 1.5), (2, NULL, 2.5);

statement ok
INSERT INTO t (c, a) VALUES (9.25, 3);

statement ok
INSERT INTO t (a, b) VALUES (4, 'four');

query ITR
SELECT * FROM t ORDER BY a;
----
1	one	1.5
2	NULL	2.5
3	NULL	9.25
4	four	NULL

statement error
INSERT INTO t VALUES (NULL, 'x', 0.0);

statement error
INSERT INTO t (b) VALUES ('no a');

statement error
INSERT INTO t VALUES (5, 'too', 1.0, 'many');

statement error
INSERT INTO t VALUES (5, 'too few');

statement error
INSERT INTO nosuchtable VALUES (1);

statement error
INSERT INTO t (nosuchcol) VALUES (1);

statement error
INSERT INTO t VALUES (1, 2, 3.0), ('x', 'y', 1.0);

query I
SELECT count(*) FROM t;
----
4

statement ok
INSERT INTO t VALUES (5, 'multi', 5.0), (6, 'row', 6.0), (7, 'insert', 7.0);

statement error
INSERT INTO t VALUES (8, 'good', 1.0), (NULL, 'bad', 2.0);

query I
SELECT count(*) FROM t;
----
7

statement ok
CREATE TABLE u (x INTEGER, y VARCHAR);

statement ok
INSERT INTO u SELECT a, b FROM t WHERE a <= 4;

query IT
SELECT * FROM u ORDER BY x;
----
1	one
2	NULL
3	NULL
4	four

statement ok
INSERT INTO u SELECT a + 100, upper(b) FROM t WHERE b IS NOT NULL AND a > 4;

query IT
SELECT * FROM u ORDER BY x;
----
1	one
2	NULL
3	NULL
4	four
105	MULTI
106	ROW
107	INSERT

statement ok
INSERT INTO u SELECT x * 10, y FROM u;

query II
SELECT count(*), max(x) FROM u;
----
14	1070

statement error
INSERT INTO t SELECT x + 2147483647, y, 1.0 FROM u;

query I
SELECT count(*) FROM t;
----
7

statement ok
INSERT INTO t SELECT x, y, 0.5 FROM u WHERE x IS NOT NULL AND x < 10;

query I
SELECT count(*) FROM t;
----
11

statement ok
DROP TABLE u;

statement error
SELECT * FROM u;

statement error
DROP TABLE u;

statement ok
DROP TABLE IF EXISTS u;

statement ok
CREATE TABLE u (z INTEGER);

query I
SELECT count(*) FROM u;
----
0

statement ok
INSERT INTO u SELECT a FROM t WHERE a > 100;

query I
SELECT count(*) FROM u;
----
0
