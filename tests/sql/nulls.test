2	eng
3	ops
4	ops
5	sales
6	NULL
7	eng
8	hr
9	ops
10	sales
11	NULL

query IT
SELECT e.id, d.dname FROM emp e JOIN dept d ON e.dept = d.id ORDER BY e.id;
----
1	eng
2	eng
3	ops
4	ops
5	sales
7	eng
8	hr
9	ops
10	sales

query IT
SELECT d.id, e.name FROM dept d LEFT JOIN emp e ON e.dept = d.id ORDER BY d.id, e.name;
