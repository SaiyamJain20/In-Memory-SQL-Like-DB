3	NULL
4	NULL
5	NULL
6	NULL
7	false
8	NULL
9	NULL
10	NULL
11	NULL

query IT
SELECT id, salary BETWEEN 4000 AND 5000 FROM emp ORDER BY id;
----
1	false
2	true
3	false
4	false
5	true
6	false
7	false
8	NULL
9	true
