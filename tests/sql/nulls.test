query IIRR
SELECT sum(boss), sum(dept), avg(boss), avg(dept) FROM emp WHERE id > 100;
----
NULL	NULL	NULL	NULL

query T
SELECT min(name) FROM emp WHERE id > 100;
----
NULL

query II
SELECT count(DISTINCT dept), count(DISTINCT boss) FROM emp;
----
5	4

query RR
SELECT sum(DISTINCT salary), avg(DISTINCT salary) FROM emp;
----
34501.5	4928.785714285715
