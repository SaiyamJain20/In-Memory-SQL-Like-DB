# Aggregation: grouping, HAVING, DISTINCT aggregates, expressions in keys, ordering of results.

statement ok
CREATE TABLE emp (id INTEGER NOT NULL, name VARCHAR, dept INTEGER, salary DOUBLE, hired DATE, boss INTEGER);

statement ok
INSERT INTO emp VALUES
 (1, 'alice', 10, 5000.5, DATE '2015-03-01', NULL),
 (2, 'bob', 10, 4200.0, DATE '2016-07-15', 1),
 (3, 'carol', 20, 6100.25, DATE '2014-01-20', 1),
 (4, 'dave', 20, 3900.0, DATE '2018-11-30', 3),
 (5, 'erin', 30, 4800.75, DATE '2017-05-05', 3),
 (6, 'frank', NULL, 3500.0, DATE '2019-02-14', 2),
 (7, 'grace', 10, 5000.5, DATE '2020-09-09', 1),
 (8, 'heidi', 40, NULL, DATE '2021-12-31', NULL),
 (9, 'ivan', 20, 4200.0, DATE '2016-07-15', 3),
 (10, 'judy', 30, NULL, DATE '2022-01-01', 5),
 (11, 'Mallory', 50, 7000.0, DATE '2013-06-06', NULL);

statement ok
CREATE TABLE dept (id INTEGER, dname VARCHAR, city VARCHAR);

statement ok
INSERT INTO dept VALUES (10, 'eng', 'berlin'), (20, 'ops', 'paris'), (30, 'sales', 'berlin'), (40, 'hr', NULL), (60, 'legal', 'rome');


query RRRII
SELECT sum(salary), avg(salary), max(salary), count(*), count(salary) FROM emp;
----
43702.0	4855.777777777777	7000.0	11	9

query IIRRRI
SELECT dept, count(*), sum(salary), min(salary), max(salary), count(boss) FROM emp GROUP BY dept ORDER BY dept NULLS LAST;
----
10	3	14201.0	4200.0	5000.5	2
20	3	14200.25	3900.0	6100.25	3
30	2	4800.75	4800.75	4800.75	2
40	1	NULL	NULL	NULL	0
50	1	7000.0	7000.0	7000.0	0
NULL	1	3500.0	3500.0	3500.0	1

query IR
SELECT dept, avg(salary) FROM emp GROUP BY dept HAVING count(*) >= 2 ORDER BY dept;
----
10	4733.666666666667
20	4733.416666666667
30	4800.75

query II
SELECT dept, count(*) FROM emp GROUP BY dept HAVING sum(salary) > 8000 ORDER BY dept;
----
10	3
20	3

query II
SELECT dept, count(*) FROM emp WHERE salary > 4000 GROUP BY dept ORDER BY count(*) DESC, dept;
----
10	3
20	2
30	1
50	1

query IIR
SELECT dept, boss, sum(salary) FROM emp GROUP BY dept, boss ORDER BY dept NULLS LAST, boss NULLS LAST;
----
10	1	9200.5
10	NULL	5000.5
20	1	6100.25
20	3	8100.0
30	3	4800.75
30	5	NULL
40	NULL	NULL
50	NULL	7000.0
NULL	2	3500.0

query IR
SELECT dept % 20, sum(salary) FROM emp GROUP BY dept % 20 ORDER BY 1 NULLS LAST;
----
0	14200.25
10	26001.75
NULL	3500.0

query TI
SELECT CASE WHEN salary >= 5000 THEN 'high' WHEN salary IS NULL THEN 'none' ELSE 'low' END AS band, count(*) FROM emp GROUP BY band ORDER BY band;
----
high	4
low	5
none	2

query TI
SELECT substring(name, 1, 1), count(*) FROM emp GROUP BY substring(name, 1, 1) ORDER BY 1;
----
M	1
a	1
b	1
c	1
d	1
e	1
f	1
g	1
h	1
i	1
j	1

query II
SELECT year(hired), count(*) FROM emp GROUP BY year(hired) ORDER BY year(hired);
----
2013	1
2014	1
2015	1
2016	2
2017	1
2018	1
2019	1
2020	1
2021	1
2022	1

query IIR
SELECT dept, count(DISTINCT salary), sum(DISTINCT salary) FROM emp GROUP BY dept ORDER BY dept NULLS LAST;
----
10	2	9200.5
20	3	14200.25
30	1	4800.75
40	0	NULL
50	1	7000.0
NULL	1	3500.0

query II
SELECT count(DISTINCT dept), count(DISTINCT boss) FROM emp;
----
5	4

query IT
SELECT dept, min(name) FROM emp GROUP BY dept ORDER BY dept NULLS LAST;
----
10	alice
20	carol
30	erin
40	heidi
50	Mallory
NULL	frank

query IT
SELECT dept, max(name) FROM emp GROUP BY dept ORDER BY dept NULLS LAST;
----
10	grace
20	ivan
30	judy
40	heidi
50	Mallory
NULL	frank

query IT
SELECT dept, min(hired) FROM emp GROUP BY dept ORDER BY dept NULLS LAST;
----
10	2015-03-01
20	2014-01-20
30	2017-05-05
40	2021-12-31
50	2013-06-06
NULL	2019-02-14

query RR
SELECT sum(salary * 2), sum(salary) * 2 FROM emp;
----
87404.0	87404.0

query RR
SELECT avg(salary + 0), avg(salary) FROM emp;
----
4855.777777777777	4855.777777777777

query IR
SELECT boss, avg(salary) FROM emp GROUP BY boss ORDER BY boss NULLS LAST;
----
1	5100.25
2	3500.0
3	4300.25
5	NULL
NULL	6000.25

query I
SELECT count(*) FROM (SELECT dept FROM emp GROUP BY dept) g;
----
6

query IR
SELECT d, s FROM (SELECT dept AS d, sum(salary) AS s FROM emp GROUP BY dept) t WHERE s > 8000 ORDER BY d;
----
10	14201.0
20	14200.25

query IIR
SELECT dept, c, s FROM (SELECT dept, count(*) AS c, sum(salary) AS s FROM emp GROUP BY dept) t ORDER BY c DESC, dept NULLS LAST;
----
10	3	14201.0
20	3	14200.25
30	2	4800.75
40	1	NULL
50	1	7000.0
NULL	1	3500.0

query RRI
SELECT min(salary), max(salary), count(*) FROM emp WHERE dept = 99;
----
NULL	NULL	0

query TT
SELECT DISTINCT dept IS NULL, boss IS NULL FROM emp ORDER BY 1, 2;
----
false	false
false	true
true	false

query IR
SELECT dept, sum(salary) FROM emp GROUP BY dept ORDER BY sum(salary) DESC NULLS LAST, dept;
----
10	14201.0
20	14200.25
50	7000.0
30	4800.75
NULL	3500.0
40	NULL

query II
SELECT dept, count(*) c FROM emp GROUP BY dept ORDER BY c, dept NULLS LAST LIMIT 3;
----
40	1
50	1
NULL	1

query IR
SELECT 1, sum(salary) FROM emp GROUP BY 1;
----
1	43702.0

query R
SELECT sum(salary) FROM emp GROUP BY dept HAVING dept = 20;
----
14200.25

query II
SELECT count(*), count(*) FROM emp;
----
11	11

query IIIII
SELECT min(id), max(id), sum(id), count(id), count(DISTINCT id) FROM emp;
----
1	11	66	11	11
