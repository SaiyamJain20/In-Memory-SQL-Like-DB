285	3.0
298	3.0
311	3.0
324	3.0

query IR
SELECT n, v FROM nums WHERE g = 5 ORDER BY n LIMIT 3 OFFSET 1000;
----
97005	3.0
97102	1.25
97199	2.75

query I
SELECT count(*) FROM nums WHERE v > 2.0 AND s = 'k3';
----
4033

query I
SELECT count(*) FROM nums WHERE s LIKE 'k1%' OR s LIKE '%7';
----
26215

query TII
SELECT l.label, count(*), sum(n.n) FROM nums n JOIN labels l ON n.g = l.g WHERE l.g < 4 GROUP BY l.label ORDER BY l.label;
----
label-0	1352	88587772
label-1	1352	88589124
label-2	1352	88590476
label-3	1352	88591828

query II
SELECT count(*), count(l.label) FROM nums n LEFT JOIN labels l ON n.g = l.g AND l.g < 50;
----
131072	67575

query T
SELECT l.label FROM labels l JOIN nums n ON n.n = l.g + 100000 ORDER BY l.g LIMIT 4;
----
label-0
label-1
label-2
label-3

query I
SELECT count(*) FROM (SELECT DISTINCT g, s FROM nums) t;
----
970

query II
SELECT count(*), sum(c) FROM (SELECT g, count(*) AS c FROM nums GROUP BY g HAVING count(*) > 1352) t;
----
0	NULL

query IIR
SELECT a.g, count(*), sum(a.v) FROM nums a WHERE a.n < 5000 GROUP BY a.g ORDER BY a.g LIMIT 3;
----
0	52	78.0
1	52	78.0
2	52	78.0

statement ok
CREATE TABLE copy_of_nums (n INTEGER NOT NULL, g INTEGER, v DOUBLE, s VARCHAR);

statement ok
INSERT INTO copy_of_nums SELECT n, g, v, s FROM nums WHERE n % 3 = 0;

query IIR
SELECT count(*), sum(n), sum(v) FROM copy_of_nums;
----
43691	2863289685	65535.25

statement ok
INSERT INTO copy_of_nums SELECT n + 1000000, g, v, s FROM copy_of_nums WHERE g = 1;

query II
SELECT count(*), max(n) FROM copy_of_nums;
----
44141	1130854
