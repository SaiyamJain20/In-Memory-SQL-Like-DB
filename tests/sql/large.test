k5	13107
k6	13107
k7	13107
k8	13107
k9	13107

query II
SELECT count(*), count(DISTINCT s) FROM nums WHERE n >= 100000;
----
31072	10

query I
SELECT count(*) FROM nums WHERE n >= 125000;
----
6072

query I
SELECT count(*) FROM nums WHERE n BETWEEN 122870 AND 122890;
----
21

query I
SELECT count(*) FROM nums WHERE n = 122879 OR n = 122880 OR n = 2047 OR n = 2048;
----
4

query II
SELECT n, g FROM nums WHERE n % 40000 = 7 ORDER BY n;
----
7	7
40007	43
80007	79
120007	18

