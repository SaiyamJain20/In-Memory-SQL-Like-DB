# Larger tables: queries cross the 2048-row vector size and the 122,880-row row-group boundary
# (the table is grown to 131,072 rows by repeated INSERT ... SELECT doubling).

statement ok
CREATE TABLE nums (n INTEGER NOT NULL, g INTEGER, v DOUBLE, s VARCHAR);

statement ok
INSERT INTO nums VALUES (0, 0, 0.0, 'k0');

statement ok
INSERT INTO nums SELECT n + 1, (n + 1) % 97, CAST((n + 1) % 13 AS DOUBLE) * 0.25, 'k' || CAST((n + 1) % 10 AS VARCHAR) FROM nums;

