statement ok
CREATE TABLE labels (g INTEGER, label VARCHAR);

statement ok
INSERT INTO labels SELECT g, 'label-' || CAST(g AS VARCHAR) FROM nums WHERE n < 97;

query IIRI
SELECT count(*), sum(n), sum(v), max(n) FROM nums;
----
131072	8589869056	196602.75	131071

query RRI
SELECT min(v), max(v), count(DISTINCT g) FROM nums;
----
0.0	3.0	97

query II
SELECT g, count(*) FROM nums GROUP BY g ORDER BY g LIMIT 5;
----
0	1352
1	1352
2	1352
3	1352
4	1352

query IR
SELECT g, sum(v) FROM nums GROUP BY g ORDER BY sum(v) DESC, g LIMIT 7;
----
0	2028.0
1	2028.0
2	2028.0
3	2028.0
4	2028.0
5	2028.0
6	2028.0

